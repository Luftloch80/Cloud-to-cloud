# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Sign in with Apple
# Create at https://developer.apple.com → Identifiers → Services ID
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to .p8 key OR paste PEM contents (use \n for newlines)
APPLE_PRIVATE_KEY=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/api/auth/apple/callback

# Dropbox app — https://www.dropbox.com/developers/apps
# Permission type: Full Dropbox. Scopes: account_info.read, files.content.write, files.metadata.read
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Set to "true" to allow demo login without Apple/Dropbox credentials
ALLOW_DEMO_MODE=true
